# --- LLM (Challenge 1 REQUIRES Vultr Serverless Inference for agent LLM calls) ---
# Create a key: Vultr console -> Serverless Inference -> subscribe -> API key
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Pick from GET https://api.vultrinference.com/v1/models (text models, e.g. qwen3.8-27b, glm-5.3, deepseek-v4.1-flash-1017)
VULTR_INFERENCE_MODEL=qwen3.8-27b
# Local dev fallback only (used when no Vultr key is set). Not valid for the Challenge 1 submission.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# --- Sandbox ---
# auto | docker | bwrap   (auto prefers docker, uses runsc/gVisor automatically if registered)
SANDBOX_MODE=auto
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MEMORY_MB=256
SANDBOX_PIDS=64
SANDBOX_CPUS=0.5
SANDBOX_IMAGE_PYTHON=python:3.12-alpine
SANDBOX_IMAGE_BASH=bash:5
# --- Server ---
HOST=127.0.0.1
PORT=4321
SANDBOX_MAX_INPUT_BYTES=1048576

# --- Competition/private workspace controls ---
# Production requires token file, Ed25519 key, required runsc, pinned image digests,
# a bounded tmpfs work directory, and the HTTPS origin. deploy/setup.sh configures these.
SAFECODE_ACCESS_TOKEN_FILE=
SAFECODE_SIGNING_KEY_FILE=
SAFECODE_ORIGIN=http://127.0.0.1:4321
SANDBOX_REQUIRED_RUNTIME=
SAFECODE_WORK_DIR=
SAFECODE_CONCURRENCY=2
SAFECODE_DAILY_ATTEMPTS=100
SAFECODE_DAILY_MODEL_CALLS=100
SAFECODE_MAX_OBJECTS=100
SAFECODE_RETENTION_HOURS=24
# Opt in only for approved data; needed for LIVE model self-healing/explanation.
# Prompts and generated code still go to the selected model provider.
SAFECODE_MODEL_INPUT_SHARING=0
SAFECODE_MODEL_OUTPUT_SHARING=0
